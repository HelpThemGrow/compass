# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your key. NEVER commit `.env.local`.
# Same variable names as the original Python app, so a working .env there can
# be copied here directly (aside from HOST/PORT, which Next.js controls via
# `next dev -H/-p` instead of env vars).
# ---------------------------------------------------------------------------

# Get a free key at https://build.nvidia.com and paste it exactly as shown
# there - it already includes its own "nvapi-" prefix, so do not add another
# one in front of it. (A doubled "nvapi-nvapi-..." prefix authenticates fine
# but every inference call then fails with a 403 - the app auto-corrects this
# specific mistake, but it is easy to avoid in the first place.)
NVIDIA_API_KEY=

# --- Generation model -------------------------------------------------------
# NVIDIA retires hosted models with little notice, so confirm what your own
# key can reach at https://build.nvidia.com before trusting a value here.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_FALLBACK=openai/gpt-oss-120b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Cost control -----------------------------------------------------------
# Confirmed against a real account: ordinary chat/embedding calls on the free
# hosted endpoint do NOT deduct from the signup credit pool. The constraint
# that actually binds is the request-rate limit, paced below by
# NVIDIA_RPM_LIMIT (a safety margin under NVIDIA's ~40/minute account cap).
# CREDIT_BUDGET is an optional safety valve if you want to cap total calls
# deliberately - it is not needed to avoid running out of free credits.
NVIDIA_RPM_LIMIT=35
CREDIT_BUDGET=200000
MAX_CALLS_PER_EVALUATION=20

# --- Embeddings -------------------------------------------------------------
# local  = CPU ONNX via transformers.js (@xenova/transformers). Costs ZERO API
#          credits. Recommended. (Node/JS equivalent of the Python app's
#          fastembed backend - same idea, same default model family.)
# nvidia = nvidia/nemotron-3-embed-1b via API. Better quality, burns credits.
# hash   = dependency-free fallback so the app still runs if nothing installs.
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Local CPU cross-encoder reranking. Free in API terms but SLOW on CPU. Hybrid
# dense+BM25 retrieval already ranks well without it, so it is off by default.
RERANK_ENABLED=false
RERANK_MAX_CANDIDATES=12
LOCAL_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Retrieval tuning -------------------------------------------------------
CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
RETRIEVE_TOP_K=8
RERANK_TOP_N=4
